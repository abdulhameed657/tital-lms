{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "titan_lms/**",
          "titan_lms/templates/**",
          "titan_lms/templates/**/*",
          "titan_lms/static/**",
          "titan_lms/static/**/*",
          "../titan_lms/**",
          "../titan_lms/templates/**",
          "../titan_lms/templates/**/*"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
