# Secret key for session hashing (change to a random string in production)
SECRET_KEY=titan-lms-super-secret-key-987654

# Database configuration (defaults to SQLite, replace with postgresql://user:pass@host:port/db in production)
DATABASE_URL=sqlite:///titan_lms.db

# Anthropic Claude API Key for AI features (Voice Tutor, Evaluation, Quiz generation)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Development Server Port
PORT=5000
